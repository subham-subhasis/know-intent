{
  "expo": {
    "name": "KnowIntent",
    "slug": "know-intent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.subham47.knowintent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow this app to access your photos to upload profile pictures.",
        "NSCameraUsageDescription": "Allow this app to use the camera to take photos."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d0086b6-c91e-424d-8d70-5a2c1a41ec29"
      }
    },
    "owner": "subham47"
  }
}
